{
  "actions": {
    "actionGroups": [
      {
        "actionGroupId": "/subscriptions/00000000-0000-0000-0000-000000000001/resourceGroups/rg-prod-01/providers/microsoft.insights/actionGroups/ag-prod-oncall",
        "webHookProperties": {}
      }
    ],
    "customProperties": {}
  },
  "autoMitigate": "Enabled",
  "checkWorkspaceAlertsStorageConfigured": true,
  "condition": {
