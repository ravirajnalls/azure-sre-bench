# Harness results — generated by `bench run`, committed only by baseline runs (issue #43)
# and result-submission PRs (issue #118). Run folders stay visible so `agent.yaml`
# descriptors can be tracked; result JSONs are committed with `git add -f`.
results/*
!results/*/
results/*/*
!results/*/agent.yaml

# Static leaderboard — generated by `bench site`, published to GitHub Pages (issue #40).
site/

__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Live-mode agent kubeconfig — minted by setup.sh, holds a read-only
# ServiceAccount token (issue #126). Never commit.
live/**/agent.kubeconfig
